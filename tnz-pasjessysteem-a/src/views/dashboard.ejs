<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard | StudentAanwezigheid</title>
  <style>
    :root { --ink: #142442; --muted: #748096; --line: #e7e9e8; --mint: #d8efdc; --green: #00a77d; --orange: #f06408; --red: #f15861; --cream: #fffaf4; }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; color: var(--ink); background-color: #24262b; background-image: radial-gradient(#55575c 1px, transparent 1px); background-size: 24px 24px; font: 13px Arial, sans-serif; }
    .shell { display: grid; grid-template-columns: 205px minmax(0, 1fr); width: min(1400px, calc(100% - 24px)); min-height: calc(100vh - 24px); margin: 12px auto; overflow: hidden; border: 1px solid #d6dfd9; border-radius: 9px; background: var(--cream); }
    aside { display: flex; flex-direction: column; padding: 16px 13px; background: var(--mint); }
    .brand { display: flex; align-items: center; gap: 8px; margin-bottom: 28px; color: #1b4a3d; font-weight: 700; font-size: 12px; }
    .mark { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 5px; color: #fff; background: var(--orange); font-weight: 700; }
    .brand small { display: block; margin-top: 2px; color: #719185; font-size: 8px; font-weight: 400; }
    nav { display: grid; gap: 4px; }
    nav a { padding: 11px 10px; border-radius: 5px; color: #315b4d; text-decoration: none; font-size: 11px; }
    nav a.active, nav a:hover { color: var(--ink); background: #fff; }
    .logout { width: 100%; margin-top: auto; padding: 11px 10px; border: 0; color: #315b4d; background: transparent; cursor: pointer; text-align: left; font-size: 11px; }
    .logout:hover { color: var(--orange); }
    .content { min-width: 0; background: var(--cream); }
    header { display: flex; align-items: center; justify-content: space-between; min-height: 54px; padding: 10px 24px; border-bottom: 1px solid var(--line); background: #fff; }
    .search { width: min(280px, 45%); padding: 9px 12px; border: 1px solid var(--line); border-radius: 5px; color: var(--muted); background: #fff; font-size: 10px; }
    .user { color: var(--muted); font-size: 11px; }
    main { padding: 25px; }
    .welcome { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
    .eyebrow { margin: 0 0 9px; color: var(--muted); font-size: 10px; }
    h1 { margin: 0; font-size: 24px; letter-spacing: -.02em; }
    .date { margin: 0; color: var(--muted); font-size: 10px; }
    .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 14px; }
    .stat, .panel { border: 1px solid var(--line); border-radius: 9px; background: #fff; }
    .stat { padding: 18px 14px; }
    .stat-label { display: block; color: var(--muted); font-size: 10px; text-transform: uppercase; }
    .stat-value { display: block; margin-top: 10px; font-size: 27px; }
    .stat:nth-child(1) .stat-value { color: var(--green); }.stat:nth-child(2) .stat-value { color: var(--orange); }.stat:nth-child(3) .stat-value { color: var(--red); }
    .stat::after { display: block; width: 58%; height: 3px; margin-top: 10px; border-radius: 4px; background: var(--green); content: ''; }.stat:nth-child(2)::after { background: var(--orange); }.stat:nth-child(3)::after { background: var(--red); }
    .panel { min-height: 230px; padding: 18px; }
    .panel h2 { margin: 0 0 8px; font-size: 14px; }.panel p { color: var(--muted); font-size: 11px; }
    @media (max-width: 700px) { .shell { grid-template-columns: 1fr; width: 100%; min-height: 100vh; margin: 0; border-width: 3px; border-radius: 0; } aside { padding: 12px; } .brand { margin-bottom: 10px; } nav { grid-template-columns: repeat(3, 1fr); } .logout { display: none; } header { padding: 10px 14px; } main { padding: 18px 14px; } .stats { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <div class="shell">
    <aside><div class="brand"><span class="mark">S</span><span>SCALDA<small>Education Portal</small></span></div><nav><a class="active" href="/dashboard">▦ &nbsp; Dashboard</a><a href="#">♧ &nbsp; Aanwezigheid</a><a href="#">⌑ &nbsp; Kalender</a><a href="#">♙ &nbsp; Gebruikers</a></nav><form method="post" action="/auth/logout"><button class="logout" type="submit">↪ &nbsp; Uitloggen</button></form></aside>
    <section class="content"><header><div class="search">⌕ &nbsp; Zoeken in Scalda...</div><span class="user"><%= user.email %></span></header><main>
      <section class="welcome"><div><p class="eyebrow">Donderdag 24 oktober</p><h1>Dashboard Overzicht</h1></div><p class="date">Docentendashboard</p></section>
      <section class="stats"><article class="stat"><span class="stat-label">Aanwezig</span><strong class="stat-value">142</strong></article><article class="stat"><span class="stat-label">Te laat</span><strong class="stat-value">18</strong></article><article class="stat"><span class="stat-label">Afwezig</span><strong class="stat-value">12</strong></article></section>
      <section class="panel"><h2>Actuele Aanwezigheidsstatus</h2><p>Live registratie van studenten via toegangspoorten en NFC-terminals.</p></section>
    </main></section>
  </div>
</body>
</html>