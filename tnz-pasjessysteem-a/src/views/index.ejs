<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Students</title>
</head>
<body>
  <h1>Students</h1>
  <ul>
    <% if (students && students.length) { %>
      <% students.forEach(function(s) { %>
        <li><%= s.name %> — <%= s.email %></li>
      <% }) %>
    <% } else { %>
      <li>No students found</li>
    <% } %>
  </ul>
</body>
</html>
